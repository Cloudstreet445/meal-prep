# MongoDB connection string — database name included in URI
MONGO_URI=mongodb://paknsave_app:password@localhost:27017/paknsave-meals?authSource=admin

# JWT signing secret — REQUIRED. Must be >= 32 chars; the app refuses to start
# with a weak/placeholder value. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Base URL of the PWA
APP_URL=http://localhost:3000

# SMTP config for password-reset emails (optional — links are logged to console if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
